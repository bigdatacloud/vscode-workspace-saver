{
  "name": "ai-workspaces",
  "displayName": "AI Workspaces",
  "description": "Manage global workspaces of terminals — auto-save state, restore terminals, and resume Claude Code sessions right where you left off",
  "version": "0.2.2",
  "publisher": "bigdatacloud",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#4F46E5",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bigdatacloud/vscode-workspace-saver.git"
  },
  "bugs": {
    "url": "https://github.com/bigdatacloud/vscode-workspace-saver/issues"
  },
  "homepage": "https://github.com/bigdatacloud/vscode-workspace-saver#readme",
  "qna": "https://github.com/bigdatacloud/vscode-workspace-saver/issues",
  "keywords": [
    "claude",
    "claude code",
    "terminal",
    "session manager",
    "workspace",
    "ai agent",
    "codex",
    "split view",
    "git worktree",
    "restore session"
  ],
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=20"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aiWorkspace.createWorkspace",
        "title": "AI Workspace: Tạo workspace mới",
        "icon": "$(add)"
      },
      {
        "command": "aiWorkspace.activateWorkspace",
        "title": "AI Workspace: Kích hoạt workspace (mở mọi terminal)"
      },
      {
        "command": "aiWorkspace.duplicateTerminal",
        "title": "AI Workspace: Nhân bản terminal ra worktree riêng",
        "icon": "$(files)"
      },
      {
        "command": "aiWorkspace.activateTerminal",
        "title": "AI Workspace: Kích hoạt riêng terminal này"
      },
      {
        "command": "aiWorkspace.closeWorkspace",
        "title": "AI Workspace: Đóng workspace"
      },
      {
        "command": "aiWorkspace.renameWorkspace",
        "title": "AI Workspace: Đổi tên workspace"
      },
      {
        "command": "aiWorkspace.deleteWorkspace",
        "title": "AI Workspace: Xóa workspace"
      },
      {
        "command": "aiWorkspace.newClaudeTerminal",
        "title": "AI Workspace: Tạo terminal Claude mới"
      },
      {
        "command": "aiWorkspace.newCodexTerminal",
        "title": "AI Workspace: Tạo terminal Codex mới"
      },
      {
        "command": "aiWorkspace.newPlainTerminal",
        "title": "AI Workspace: Tạo terminal mới",
        "icon": "$(add)"
      },
      {
        "command": "aiWorkspace.workspaceSettings",
        "title": "AI Workspace: Cài đặt workspace"
      },
      {
        "command": "aiWorkspace.cleanWorktrees",
        "title": "AI Workspace: Dọn worktree"
      },
      {
        "command": "aiWorkspace.addRole",
        "title": "AI Workspace: Thêm vai"
      },
      {
        "command": "aiWorkspace.manageRoles",
        "title": "AI Workspace: Quản lý vai"
      },
      {
        "command": "aiWorkspace.assignRole",
        "title": "AI Workspace: Gắn vai cho terminal"
      },
      {
        "command": "aiWorkspace.addToGrid",
        "title": "AI Workspace: Thêm terminal này vào lưới",
        "icon": "$(add)"
      },
      {
        "command": "aiWorkspace.nextTerminal",
        "title": "AI Workspace: Terminal kế tiếp trong workspace"
      },
      {
        "command": "aiWorkspace.prevTerminal",
        "title": "AI Workspace: Terminal trước đó trong workspace"
      },
      {
        "command": "aiWorkspace.viewSplit",
        "title": "AI Workspace: Xem các terminal song song (xếp lưới)",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "aiWorkspace.viewSplitOff",
        "title": "AI Workspace: Thôi xem song song (dồn về một nhóm)"
      },
      {
        "command": "aiWorkspace.moveWorkspaceUp",
        "title": "AI Workspace: Đưa workspace lên trên",
        "icon": "$(arrow-up)"
      },
      {
        "command": "aiWorkspace.moveWorkspaceDown",
        "title": "AI Workspace: Đưa workspace xuống dưới",
        "icon": "$(arrow-down)"
      },
      {
        "command": "aiWorkspace.unpinWorkspaceOrder",
        "title": "AI Workspace: Bỏ ghim thứ tự workspace (về tự sắp theo lần dùng)"
      },
      {
        "command": "aiWorkspace.moveTerminalUp",
        "title": "AI Workspace: Đưa terminal lên trên",
        "icon": "$(arrow-up)"
      },
      {
        "command": "aiWorkspace.moveTerminalDown",
        "title": "AI Workspace: Đưa terminal xuống dưới",
        "icon": "$(arrow-down)"
      },
      {
        "command": "aiWorkspace.moveTerminal",
        "title": "AI Workspace: Chuyển terminal sang workspace khác"
      },
      {
        "command": "aiWorkspace.showAuditLog",
        "title": "AI Workspace: Xem log điều phối"
      },
      {
        "command": "aiWorkspace.createTeam",
        "title": "AI Workspace: Lập tổ"
      },
      {
        "command": "aiWorkspace.setStartCommand",
        "title": "AI Workspace: Đặt lệnh khởi động cho terminal"
      },
      {
        "command": "aiWorkspace.removeTerminal",
        "title": "AI Workspace: Bỏ terminal khỏi workspace"
      },
      {
        "command": "aiWorkspace.focusTerminal",
        "title": "AI Workspace: Mở terminal"
      },
      {
        "command": "aiWorkspace.addOpenTerminalToWorkspace",
        "title": "AI Workspace: Thêm terminal đang mở vào workspace"
      },
      {
        "command": "aiWorkspace.assignClaudeSession",
        "title": "AI Workspace: Gắn session AI vào terminal"
      },
      {
        "command": "aiWorkspace.renameTerminal",
        "title": "AI Workspace: Đổi tên terminal"
      },
      {
        "command": "aiWorkspace.showTerminalPath",
        "title": "AI Workspace: Xem đường dẫn terminal"
      },
      {
        "command": "aiWorkspace.voiceToggle",
        "title": "AI Workspace: Nghe giọng nói vào terminal (bật / dừng)",
        "icon": "$(mic)"
      },
      {
        "command": "aiWorkspace.voiceSelectMicrophone",
        "title": "AI Workspace: Chọn micro nghe giọng nói"
      },
      {
        "command": "aiWorkspace.voiceSetApiKey",
        "title": "AI Workspace: Nhập API key nghe giọng nói (OpenAI / Gemini)"
      },
      {
        "command": "aiWorkspace.showWorkspaceInfo",
        "title": "AI Workspace: Xem thông tin workspace"
      }
    ],
    "keybindings": [
      {
        "command": "aiWorkspace.newPlainTerminal",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      },
      {
        "command": "aiWorkspace.newClaudeTerminal",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "aiWorkspace.nextTerminal",
        "key": "ctrl+tab",
        "when": "terminalFocus || focusedView == aiWorkspace.workspaces"
      },
      {
        "command": "aiWorkspace.prevTerminal",
        "key": "ctrl+shift+tab",
        "when": "terminalFocus || focusedView == aiWorkspace.workspaces"
      },
      {
        "command": "aiWorkspace.voiceToggle",
        "key": "ctrl+shift+y",
        "mac": "cmd+shift+y",
        "when": "terminalFocus || focusedView == aiWorkspace.workspaces || aiWorkspace.dangNghe"
      }
    ],
    "colors": [
      {
        "id": "aiWorkspace.mauAnthropic",
        "description": "Màu chấm của terminal Claude trong cây AI Workspaces (màu thương hiệu Anthropic).",
        "defaults": { "dark": "#D97757", "light": "#C8613F", "highContrast": "#F0A080", "highContrastLight": "#8A3A1E" }
      },
      {
        "id": "aiWorkspace.mauOpenAI",
        "description": "Màu chấm của terminal Codex trong cây AI Workspaces (màu thương hiệu OpenAI).",
        "defaults": { "dark": "#10A37F", "light": "#0E8A6B", "highContrast": "#3FD1A9", "highContrastLight": "#0A6650" }
      },
      {
        "id": "aiWorkspace.mauShell",
        "description": "Màu chấm của terminal shell thường trong cây AI Workspaces.",
        "defaults": { "dark": "descriptionForeground", "light": "descriptionForeground", "highContrast": "foreground", "highContrastLight": "foreground" }
      }
    ],
    "configuration": {
      "title": "AI Workspace",
      "properties": {
        "aiWorkspace.confirmActivateOnClick": {
          "type": "boolean",
          "default": true,
          "description": "Bấm vào một terminal đang đóng trong cây thì hỏi xác nhận trước khi kích hoạt — tránh bấm nhầm mà nối lại một phiên agent (nạp lại ngữ cảnh, tốn token). Lệnh \"Kích hoạt riêng terminal này\" ở menu chuột phải không hỏi."
        },
        "aiWorkspace.splitLayout": {
          "type": "string",
          "default": "auto",
          "description": "Bố cục mặc định khi xem các terminal song song: \"auto\" (tự tính theo số terminal đang mở) hoặc dạng <cột>x<dòng> như \"3x3\", \"4x2\" (mỗi cạnh 1–6). Bảng chọn lúc chạy lệnh ghi đè và lưu lại giá trị này."
        },
        "aiWorkspace.splitAskLayout": {
          "type": "boolean",
          "default": true,
          "description": "Hỏi bố cục mỗi lần xem song song. Tắt thì dùng thẳng `aiWorkspace.splitLayout` — bật lại ở đây khi muốn chọn lại."
        },
        "aiWorkspace.voice.model": {
          "type": "string",
          "default": "local",
          "enum": ["quan", "local", "openai:gpt-4o-mini-transcribe", "openai:gpt-4o-transcribe", "openai:whisper-1", "gemini:gemini-3.1-flash-lite", "gemini:gemini-3.8-flash", "gemini:gemini-3.6-flash"],
          "enumDescriptions": [
            "QUAN-Transcribe 1.0 — chuyên tiếng Việt, chạy trên máy; cần Python + torch, lần đầu tải ~2 GB; trả chữ thường không dấu câu",
            "Nemotron 3.5 của VS Code — offline, không cần key; extension làm nóng model lúc mở cửa sổ",
            "OpenAI gpt-4o-mini-transcribe — nhanh, rẻ; cần OpenAI API key",
            "OpenAI gpt-4o-transcribe — chính xác hơn; cần OpenAI API key",
            "OpenAI whisper-1 — đời cũ; cần OpenAI API key",
            "Gemini 3.1 Flash Lite — nhanh nhất (~2 s), rẻ nhất; cần Gemini API key",
            "Gemini 3.8 Flash — Flash đời mới nhất (10/2026); cần Gemini API key",
            "Gemini 3.6 Flash — bản GA trước đó, dùng khi 3.8 quá tải; cần Gemini API key"
          ],
          "description": "Model chuyển giọng nói thành chữ dùng mặc định khi bấm phím nghe. Đường cloud ghi âm bằng helper Windows và gửi âm thanh lên dịch vụ; key giữ trong kho bí mật của VS Code (lệnh AI Workspace: Nhập API key)."
        },
        "aiWorkspace.voice.quanPython": {
          "type": "string",
          "default": "python",
          "description": "Trình thông dịch Python dùng để chạy QUAN-Transcribe (đường dẫn đầy đủ nếu `python` trong PATH không phải cái đã cài gói)."
        },
        "aiWorkspace.voice.askOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Bấm phím nghe thì hiện bảng chọn local/cloud và model (Enter = mặc định). Tắt để bấm là dùng mặc định ngay."
        },
        "aiWorkspace.voice.language": {
          "type": "string",
          "default": "vi",
          "description": "Mã ngôn ngữ gửi kèm cho dịch vụ cloud (vi, en…). Đường local dùng agents.voice.language của VS Code."
        },
        "aiWorkspace.voice.warmUpOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Nạp sẵn model nhận dạng giọng nói của VS Code ngay sau khi mở cửa sổ, để lần bấm phím nghe đầu tiên nói được ngay. Mặc định TẮT vì nó bật micro khoảng 40 giây ngay sau khi cửa sổ mở và mở một tab nháp trong vùng editor. Bật nếu hay dùng giọng nói và chấp nhận hai điều đó."
        },
        "aiWorkspace.splitView.closePanelAfterLayout": {
          "type": "boolean",
          "default": true,
          "description": "Thu panel (Terminal, Debug Console…) sau khi xếp lưới xem song song, để lưới dùng trọn màn hình. Terminal nằm dưới panel vẫn chạy — bấm Ctrl+J để hiện lại. Tắt nếu thấy lượt xếp lưới SAU bị sai ô."
        },
        "aiWorkspace.terminalLocation": {
          "type": "string",
          "enum": ["editor", "panel"],
          "enumDescriptions": [
            "Mở terminal thành tab trong khu editor (vùng chính)",
            "Mở terminal trong panel dưới như mặc định của VS Code"
          ],
          "default": "editor",
          "description": "Nơi mở các terminal do AI Workspace tạo hoặc khôi phục."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "aiWorkspace.workspaces",
          "name": "AI Workspaces"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aiWorkspace.createWorkspace",
          "when": "view == aiWorkspace.workspaces",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "aiWorkspace.activateWorkspace",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "1_activate"
        },
        {
          "command": "aiWorkspace.activateTerminal",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "0_activate"
        },
        {
          "command": "aiWorkspace.duplicateTerminal",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "0_activate@2"
        },
        {
          "command": "aiWorkspace.closeWorkspace",
          "when": "view == aiWorkspace.workspaces && viewItem == aiWorkspaceActive",
          "group": "9_close"
        },
        {
          "command": "aiWorkspace.newClaudeTerminal",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "2_terminal@1"
        },
        {
          "command": "aiWorkspace.newCodexTerminal",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "2_terminal@2"
        },
        {
          "command": "aiWorkspace.newPlainTerminal",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "2_terminal@3"
        },
        {
          "command": "aiWorkspace.newPlainTerminal",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "inline"
        },
        {
          "command": "aiWorkspace.showWorkspaceInfo",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "3_edit@1"
        },
        {
          "command": "aiWorkspace.workspaceSettings",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "3_edit@2"
        },
        {
          "command": "aiWorkspace.renameWorkspace",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "3_edit@3"
        },
        {
          "command": "aiWorkspace.deleteWorkspace",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "3_edit@4"
        },
        {
          "command": "aiWorkspace.cleanWorktrees",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "3_edit@5"
        },
        {
          "command": "aiWorkspace.viewSplit",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "1_activate@2"
        },
        {
          "command": "aiWorkspace.viewSplitOff",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "1_activate@3"
        },
        {
          "command": "aiWorkspace.moveWorkspaceUp",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "5_order@1"
        },
        {
          "command": "aiWorkspace.moveWorkspaceDown",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "5_order@2"
        },
        {
          "command": "aiWorkspace.unpinWorkspaceOrder",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "5_order@3"
        },
        {
          "command": "aiWorkspace.addRole",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "4_role@1"
        },
        {
          "command": "aiWorkspace.manageRoles",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "4_role@2"
        },
        {
          "command": "aiWorkspace.showAuditLog",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiWorkspace(Active|Inactive)/",
          "group": "4_role@3"
        },
        {
          "command": "aiWorkspace.assignRole",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "1_edit"
        },
        {
          "command": "aiWorkspace.createTeam",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminalClaudeDieuPhoi/",
          "group": "0_team"
        },
        {
          "command": "aiWorkspace.setStartCommand",
          "when": "view == aiWorkspace.workspaces && viewItem == aiTerminalPlain",
          "group": "1_edit"
        },
        {
          "command": "aiWorkspace.assignClaudeSession",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "1_edit"
        },
        {
          "command": "aiWorkspace.renameTerminal",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "1_edit"
        },
        {
          "command": "aiWorkspace.showTerminalPath",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "1_edit"
        },
        {
          "command": "aiWorkspace.addToGrid",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "0_activate@3"
        },
        {
          "command": "aiWorkspace.moveTerminalUp",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "1_order@1"
        },
        {
          "command": "aiWorkspace.moveTerminalDown",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "1_order@2"
        },
        {
          "command": "aiWorkspace.moveTerminal",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "2_remove@1"
        },
        {
          "command": "aiWorkspace.removeTerminal",
          "when": "view == aiWorkspace.workspaces && viewItem =~ /aiTerminal(Claude|Plain)/",
          "group": "2_remove@2"
        }
      ],
      "terminal/title/context": [
        {
          "command": "aiWorkspace.addOpenTerminalToWorkspace"
        }
      ],
      "editor/title/context": [
        {
          "command": "aiWorkspace.addOpenTerminalToWorkspace",
          "when": "resourceScheme == vscode-terminal"
        }
      ],
      "terminal/context": [
        {
          "command": "aiWorkspace.addOpenTerminalToWorkspace"
        }
      ],
      "commandPalette": [
        {
          "command": "aiWorkspace.setStartCommand",
          "when": "false"
        },
        {
          "command": "aiWorkspace.removeTerminal",
          "when": "false"
        },
        {
          "command": "aiWorkspace.focusTerminal",
          "when": "false"
        },
        {
          "command": "aiWorkspace.duplicateTerminal",
          "when": "false"
        },
        {
          "command": "aiWorkspace.assignClaudeSession",
          "when": "false"
        },
        {
          "command": "aiWorkspace.renameTerminal",
          "when": "false"
        },
        {
          "command": "aiWorkspace.showTerminalPath",
          "when": "false"
        },
        {
          "command": "aiWorkspace.assignRole",
          "when": "false"
        },
        {
          "command": "aiWorkspace.addToGrid",
          "when": "false"
        },
        {
          "command": "aiWorkspace.moveTerminalUp",
          "when": "false"
        },
        {
          "command": "aiWorkspace.moveTerminalDown",
          "when": "false"
        },
        {
          "command": "aiWorkspace.moveTerminal",
          "when": "false"
        },
        {
          "command": "aiWorkspace.createTeam",
          "when": "false"
        },
        {
          "command": "aiWorkspace.activateTerminal",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:vscode": "tsc -p tsconfig.json --outDir out && node -e \"require('fs').rmSync('.vscode-test/user-data',{recursive:true,force:true})\"",
    "test:vscode": "npm run build && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.93.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.23.0",
    "mocha": "^10.7.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
